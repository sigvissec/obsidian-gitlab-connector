{
	"name": "obsidian-gitlab-connector",
	"version": "0.1.0",
	"description": "Sync markdown files between your Obsidian vault and a GitLab repository.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "run-s test:unit test:e2e",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:android": "wdio run ./wdio.mobile.conf.mts"
	},
	"keywords": [
		"obsidian",
		"gitlab",
		"sync",
		"git"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/diff": "^6.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.11.0",
		"@vitest/coverage-v8": "^4.1.4",
		"@wdio/appium-service": "^9.27.0",
		"@wdio/cli": "^9.27.0",
		"@wdio/globals": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"@wdio/spec-reporter": "^9.27.0",
		"appium": "^3.3.0",
		"appium-uiautomator2-driver": "^7.1.2",
		"esbuild": "^0.28.0",
		"memfs": "^4.57.1",
		"mocha": "^11.7.5",
		"npm-run-all2": "^8.0.4",
		"obsidian": "latest",
		"obsidian-launcher": "^3.0.2",
		"tsx": "^4.21.0",
		"typescript": "^5.5.0",
		"vitest": "^4.1.4",
		"wdio-obsidian-reporter": "^3.0.2",
		"wdio-obsidian-service": "^3.0.2"
	},
	"dependencies": {
		"@isomorphic-git/lightning-fs": "^4.6.0",
		"buffer": "^6.0.3",
		"diff": "^8.0.4",
		"isomorphic-git": "^1.27.0"
	}
}
