{
	"name": "obsidian-gitlab-connector",
	"version": "0.1.0",
	"description": "Sync markdown files between your Obsidian vault and a GitLab repository.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"gitlab",
		"sync",
		"git"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/diff": "^6.0.0",
		"@types/node": "^20.11.0",
		"esbuild": "^0.28.0",
		"obsidian": "latest",
		"typescript": "^5.5.0"
	},
	"dependencies": {
		"@isomorphic-git/lightning-fs": "^4.6.0",
		"buffer": "^6.0.3",
		"diff": "^8.0.4",
		"isomorphic-git": "^1.27.0"
	}
}
